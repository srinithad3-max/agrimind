# Optional: LLM for farmer-friendly summaries in Telugu/Hindi + "Ask AgriMind" chat.
# Copy this file to .env and fill ONE of the options. Without it, the app uses rule-based advice.

# Groq (free tier, fast): https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Google Gemini (OpenAI-compatible endpoint):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=
# LLM_MODEL=gemini-2.0-flash

# Local Ollama (offline):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
